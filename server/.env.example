# server/.env 예시(이름만). 실제 값은 server/.env에 적고, 그 파일은 git에 넣지 않는다.
# KEY=VALUE 꼴의 속성 파일로 읽는다(application.yml의 spring.config.import).
# 값에 따옴표를 쓰면 따옴표까지 값이 된다. 따옴표 없이 적는다.
# 같은 이름의 환경변수가 있으면 환경변수가 이긴다.

# LLM: gemini / fake
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0
LLM_API_KEY=

# 로컬 MySQL 8.4(Docker). 호스트·포트·DB 이름만. JDBC 속성은 application.yml에 있다
DB_URL=jdbc:mysql://127.0.0.1:3306/privacyask
DB_USER=privacyask
DB_PASSWORD=
