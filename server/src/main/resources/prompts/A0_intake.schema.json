{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "OWN_CASE",
              "ACTION",
              "INCIDENT",
              "RIGHTS_REQUEST",
              "LAW_AREA"
            ]
          },
          "quote": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "quote"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "signals"
  ],
  "additionalProperties": false
}
