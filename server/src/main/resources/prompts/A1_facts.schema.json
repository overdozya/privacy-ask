{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "flows": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "flow": { "type": "integer", "minimum": 1, "maximum": 20 },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "origin": { "type": "string", "minLength": 1, "maxLength": 200 },
          "destination": { "type": "string", "minLength": 1, "maxLength": 200 },
          "service_name": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "required": ["flow", "label", "origin", "destination"],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "properties": {
          "fact": { "type": "string", "minLength": 1, "maxLength": 10 },
          "flows": { "type": "array", "maxItems": 8, "items": { "type": "integer", "minimum": 1, "maximum": 20 } },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "detail": { "type": "string", "minLength": 1, "maxLength": 500 }
              },
              "required": ["label"],
              "additionalProperties": false
            }
          },
          "status": { "type": "string", "enum": ["CONFIRMED", "INFERRED"] },
          "quote": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "required": ["fact", "flows", "values", "status", "quote"],
        "additionalProperties": false
      }
    }
  },
  "required": ["flows", "facts"],
  "additionalProperties": false
}
