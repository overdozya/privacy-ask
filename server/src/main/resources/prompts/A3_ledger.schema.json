{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "flow": {
            "type": "integer"
          },
          "fact": {
            "type": "string"
          },
          "match": {
            "type": "string",
            "enum": [
              "명시",
              "포괄",
              "없음"
            ]
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "row_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "row_id",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "flow",
          "fact",
          "match",
          "rows"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cites"
  ],
  "additionalProperties": false
}
