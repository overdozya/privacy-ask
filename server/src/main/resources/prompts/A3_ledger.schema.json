{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cites": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "properties": {
          "flow": { "type": "integer", "minimum": 1, "maximum": 20 },
          "fact": { "type": "string", "minLength": 1, "maxLength": 10 },
          "match": { "type": "string", "enum": ["명시", "포괄", "없음"] },
          "rows": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "properties": {
                "row_id": { "type": "string", "minLength": 1, "maxLength": 40 },
                "quote": { "type": "string", "minLength": 1, "maxLength": 300 }
              },
              "required": ["row_id", "quote"],
              "additionalProperties": false
            }
          },
          "reason": { "type": "string", "maxLength": 300 }
        },
        "required": ["flow", "fact", "match", "rows"],
        "additionalProperties": false
      }
    }
  },
  "required": ["cites"],
  "additionalProperties": false
}
