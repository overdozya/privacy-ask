{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "MISSED",
              "OUTSIDE"
            ]
          },
          "issue": {
            "type": "string"
          },
          "flow": {
            "type": "integer"
          },
          "quote": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "quote",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "flags"
  ],
  "additionalProperties": false
}
