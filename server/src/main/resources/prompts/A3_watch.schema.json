{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "flags": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["MISSED", "OUTSIDE"] },
          "issue": { "type": "string", "minLength": 1, "maxLength": 60 },
          "flow": { "type": "integer", "minimum": 1, "maximum": 20 },
          "quote": { "type": "string", "minLength": 1, "maxLength": 300 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "required": ["kind", "quote", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": ["flags"],
  "additionalProperties": false
}
